# ---------------------------------------------------------------------------
# AVD AI Agent - configuration
# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit a populated .env.
# In Azure, every value below comes from App Settings / Key Vault references,
# and all Azure access uses Managed Identity (no keys at all).
# ---------------------------------------------------------------------------

# ---- Runtime mode ---------------------------------------------------------
# mock  = fully offline, deterministic simulated AVD estate (default)
# azure = real Azure Resource Manager / AVD / Automation calls
AVD_AGENT_MODE=mock

APP_ENV=local
LOG_LEVEL=INFO

# ---- Azure OpenAI (reasoning layer) --------------------------------------
# Leave AZURE_OPENAI_ENDPOINT empty to use the deterministic MockLlmClient.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Auth: "managed_identity" (preferred, no secret) or "api_key" (local dev only)
AZURE_OPENAI_AUTH_MODE=managed_identity
# ONLY used when AZURE_OPENAI_AUTH_MODE=api_key. Prefer Key Vault reference.
AZURE_OPENAI_API_KEY=

# ---- Azure target estate --------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# ---- Azure Automation (controlled PowerShell execution layer) -------------
AUTOMATION_ACCOUNT_NAME=
AUTOMATION_RESOURCE_GROUP=
AUTOMATION_HYBRID_WORKER_GROUP=

# ---- Log Analytics --------------------------------------------------------
LOG_ANALYTICS_WORKSPACE_ID=

# ---- Safety switches ------------------------------------------------------
# Hard kill-switch: when false, no remediation may execute in any circumstance.
REMEDIATION_ENABLED=true
# Risk levels that may NEVER execute in this environment (comma separated).
BLOCKED_RISK_LEVELS=high
# Approval token time-to-live in seconds.
APPROVAL_TTL_SECONDS=900

# ---- Audit ----------------------------------------------------------------
AUDIT_SINK=file
AUDIT_FILE_PATH=./data/audit/audit.jsonl
DATA_DIR=./data
